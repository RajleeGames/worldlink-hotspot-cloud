+{% extends 'base.html' %}{% load translations %}
+{% block content %}
+<div class="page-heading"><div><p class="eyebrow">WORLDLINK · MANUAL PAYOUT</p><h1>{% t 'Withdrawal' %} #{{ item.pk }}</h1><p>{{ item.company.name }} · {{ item.created_at|date:'d M Y H:i' }}</p></div><a class="button button-secondary" href="{% url 'wallets:queue' %}">{% t 'Back to queue' %}</a></div>
