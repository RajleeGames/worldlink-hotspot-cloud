+{% extends 'base.html' %}{% load translations %}
+{% block content %}
+<div class="page-heading"><div><p class="eyebrow">WORLDLINK · FINANCE OPERATIONS</p><h1>{% t 'Withdrawals & collections' %}</h1><p>{% t 'Private team queue for verified numbers and manual transfers' %}</p></div>{% if can_manage_finance %}<a class="button button-primary" href="{% url 'wallets:collection_new' %}">＋ {% t 'Record cleared payment' %}</a>{% endif %}</div>
+<div class="wallet-stats">
+  <div class="wallet-metric"><span>{% t 'Available balances' %}</span><strong>TZS {{ wallet_total|floatformat:0 }}</strong><small>{% t 'Across WorldLink-held business wallets' %}</small></div>
+  <div class="wallet-metric"><span>{% t 'Reserved for withdrawals' %}</span><strong>TZS {{ reserved_total|floatformat:0 }}</strong><small>{% t 'Do not pay twice' %}</small></div>
+  <div class="wallet-metric"><span>{% t 'Awaiting manual payment' %}</span><strong>{{ pending|length }}</strong><small>{% t 'Open requests' %}</small></div>
+</div>
+<section class="panel"><div class="panel-heading"><div><h2>{% t 'Withdrawal requests awaiting payment' %}</h2><p>{% t 'Verify bank/merchant funds and manually transfer before marking paid' %}</p></div></div>
+<div class="table-wrap"><table class="data-table wallet-table"><thead><tr><th>{% t 'Business' %}</th><th>{% t 'Owner / recipient' %}</th><th>{% t 'Amount' %}</th><th>{% t 'Requested' %}</th><th></th></tr></thead><tbody>
+{% for item in pending %}<tr><td><strong>{{ item.company.name }}</strong></td><td>{{ item.recipient_name }}<span class="wallet-subline">{{ item.destination.get_provider_display }} · {{ item.recipient_phone }}</span></td><td><strong>TZS {{ item.amount|floatformat:0 }}</strong></td><td>{{ item.created_at|date:'d M Y H:i' }}</td><td><a class="button button-secondary button-small" href="{% url 'wallets:withdrawal_detail' item.pk %}">{% t 'Review' %}</a></td></tr>{% empty %}<tr><td colspan="5" class="empty-cell">{% t 'No withdrawal requests awaiting payment.' %}</td></tr>{% endfor %}</tbody></table></div></section>
+<section class="panel"><div class="panel-heading"><div><h2>{% t 'Numbers awaiting verification' %}</h2><p>{% t 'Compare against trusted mobile-money provider evidence before approval' %}</p></div></div>
+<div class="wallet-review-list">{% for dest in numbers %}<div class="wallet-review-row"><div><strong>{{ dest.company.name }}</strong><span>{{ dest.account_name }} · {{ dest.get_provider_display }} · {{ dest.phone }}</span><small>{% t 'Submitted by' %} {{ dest.created_by.get_full_name|default:dest.created_by.username }} · {{ dest.created_at|date:'d M Y' }}</small></div>{% if can_manage_finance %}<form method="post" action="{% url 'wallets:destination_review' dest.pk %}" class="wallet-review-form">{% csrf_token %}<label class="sr-only" for="evidence-{{ dest.pk }}">{% t 'Verification evidence' %}</label><input id="evidence-{{ dest.pk }}" type="text" name="evidence" minlength="10" maxlength="250" required placeholder="Provider check / account-name evidence"><button class="button button-primary button-small" name="action" value="approve" type="submit">{% t 'Verify number' %}</button><button class="button button-secondary button-small" name="action" value="reject" type="submit">{% t 'Reject' %}</button></form>{% else %}<span class="pill pending">{% t 'Needs verification' %}</span>{% endif %}</div>{% empty %}<div class="empty-small">{% t 'No numbers awaiting verification.' %}</div>{% endfor %}</div></section>
+<section class="panel"><div class="panel-heading"><div><h2>{% t 'Recent decisions' %}</h2><p>{% t 'Completed, rejected and cancelled requests' %}</p></div></div><div class="table-wrap"><table class="data-table wallet-table"><thead><tr><th>{% t 'Business' %}</th><th>{% t 'Amount' %}</th><th>{% t 'Status' %}</th><th></th></tr></thead><tbody>{% for item in recent %}<tr><td>{{ item.company.name }}</td><td>TZS {{ item.amount|floatformat:0 }}</td><td>{{ item.get_status_display }}</td><td><a class="text-link" href="{% url 'wallets:withdrawal_detail' item.pk %}">{% t 'View' %}</a></td></tr>{% empty %}<tr><td colspan="4" class="empty-cell">{% t 'No decisions recorded yet.' %}</td></tr>{% endfor %}</tbody></table></div></section>
+{% endblock %}
