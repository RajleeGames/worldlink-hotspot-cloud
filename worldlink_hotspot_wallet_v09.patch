+.wallet-dashboard-link{display:flex;align-items:center;gap:13px;background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:15px 17px;margin-bottom:15px;transition:border-color .15s,background .15s}
+.wallet-dashboard-link:hover{border-color:var(--accent);background:var(--accent-soft)}
+.wallet-dashboard-link>span:nth-child(2){flex:1;display:flex;flex-direction:column;gap:3px}
+.wallet-dashboard-link strong{font-size:11.5px;font-weight:550}
+.wallet-dashboard-link small{font-size:10px;color:var(--muted)}
+.wallet-dashboard-arrow{font-size:19px;color:var(--accent)}
+.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
+@media(max-width:1100px){.wallet-columns{grid-template-columns:1fr}.wallet-review-row{grid-template-columns:1fr}.wallet-form-layout{grid-template-columns:minmax(0,1fr) minmax(190px,.5fr)}}
+@media(max-width:760px){.wallet-hero{grid-template-columns:1fr;padding:23px 20px;gap:16px}.wallet-hero-side{border-left:0;border-top:1px solid rgba(255,255,255,.18);padding:16px 0 0}.wallet-stats{grid-template-columns:1fr}.wallet-metric{padding:14px 17px}.wallet-metric strong{font-size:19px}.wallet-form-layout{grid-template-columns:1fr}.wallet-info{padding:18px}.wallet-form-padding{padding:18px}.wallet-hero-amount{font-size:31px}.wallet-review-form{align-items:stretch}.wallet-review-form input{flex-basis:100%}}
