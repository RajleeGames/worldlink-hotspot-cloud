# Windows setup script generates .env with a random secret key.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
ALLOW_PUBLIC_SIGNUP=True
# Set False before production. For deployment set DEBUG=False and configure HTTPS.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://wifi.worldlinksecurity.co.tz
# SECURE_SSL_REDIRECT=True
# TRUST_PROXY_SSL_HEADER=True
# DB_ENGINE=postgresql
# DB_NAME=worldlink_hotspot
# DB_USER=worldlink
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# v0.8 EvPay test lab. DISABLED unless explicitly enabled.
# Use ONLY sandbox merchant credentials when EVPAY_ENVIRONMENT=sandbox.
EVPAY_ENABLED=False
EVPAY_ENVIRONMENT=sandbox
EVPAY_PRODUCTION_CHARGES_ENABLED=False
EVPAY_COMPANY_ID=0
# Ask EvPay for the official API origin for YOUR sandbox account; do not guess.
EVPAY_BASE_URL=
# Must be publicly reachable HTTPS so EvPay can send signed webhook events.
EVPAY_PUBLIC_BASE_URL=
EVPAY_CLIENT_ID=
EVPAY_CLIENT_SECRET=
EVPAY_SIG_KEY=
EVPAY_WEBHOOK_SECRET=
# Random non-secret routing identifier, e.g. generate with secrets.token_urlsafe(24).
EVPAY_WEBHOOK_TOKEN=
