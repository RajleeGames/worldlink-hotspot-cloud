# Windows setup script generates .env with a random secret key.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
ALLOW_PUBLIC_SIGNUP=True
# Set False before production. For deployment set DEBUG=False and configure HTTPS.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://wifi.worldlinksecurity.co.tz
# SECURE_SSL_REDIRECT=True
# TRUST_PROXY_SSL_HEADER=True
# DB_ENGINE=postgresql
# DB_NAME=worldlink_hotspot
# DB_USER=worldlink
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# v0.8 EvPay test lab. DISABLED unless explicitly enabled.
# Use ONLY sandbox merchant credentials when EVPAY_ENVIRONMENT=sandbox.
EVPAY_ENABLED=False
EVPAY_ENVIRONMENT=sandbox
EVPAY_PRODUCTION_CHARGES_ENABLED=False
EVPAY_COMPANY_ID=0
# Ask EvPay for the official API origin for YOUR sandbox account; do not guess.
EVPAY_BASE_URL=
# Must be publicly reachable HTTPS so EvPay can send signed webhook events.
EVPAY_PUBLIC_BASE_URL=
EVPAY_CLIENT_ID=
EVPAY_CLIENT_SECRET=
EVPAY_SIG_KEY=
EVPAY_WEBHOOK_SECRET=
# Random non-secret routing identifier, e.g. generate with secrets.token_urlsafe(24).
EVPAY_WEBHOOK_TOKEN=

# OFF until WorldLink/EvPay approves pooled collection on behalf of businesses.
# Explicitly list business PKs allowed to charge the WorldLink merchant account.
EVPAY_PUBLIC_CHECKOUT_ENABLED=False
EVPAY_COLLECTION_COMPANY_IDS=
EVPAY_COLLECTION_WEBHOOK_TOKEN=
# Keep TZS 1000 for the first real USSD test; increase only after pilot review.
EVPAY_PUBLIC_MAX_AMOUNT_TZS=1000
# Required for live checkout: shared Redis (not exposed to the public Internet).
# WHC_REDIS_URL=redis://127.0.0.1:6379/1

# Required to sell Wi-Fi automatically. Set ONLY after a private VPN from the
# VPS to Omada Controller works, TLS certificate is trusted, and access tested.
OMADA_LIVE_ENABLED=False
OMADA_PILOT_COMPANY_ID=0
OMADA_CONTROLLER_URL=
OMADA_CONTROLLER_ID=
OMADA_OPERATOR_NAME=
OMADA_OPERATOR_PASSWORD=
# Path to the controller's trusted CA certificate on the VPS (no verify=False).
OMADA_CA_FILE=
OMADA_AP_MAC=
OMADA_SSID=WORLDLINK-TEST

# MikroTik RouterOS v7 pilot: explicit LAN/VPN IP allowlist (NO public IP access).
# Example: MIKROTIK_ALLOWED_CIDRS=192.168.88.1/32
# Leave empty until you know the device's real private management address.
MIKROTIK_ALLOWED_CIDRS=
# Optional: trusted router certificate-authority PEM path for HTTPS verification.
MIKROTIK_CA_FILE=
